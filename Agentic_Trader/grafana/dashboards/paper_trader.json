    {
      "id": 26,
      "title": "Pre-trade quant suite (purged walk-forward, out-of-sample)",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "trader-history"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "trader-history"
          },
          "refId": "A",
          "queryText": "SELECT mode, symbol, ROUND(score,2) AS score, CASE edge WHEN 1 THEN 'yes' ELSE 'no' END AS oos_edge, CASE veto WHEN 1 THEN 'VETO' ELSE '' END AS gate, ROUND(size_mult,2) AS size_x, ROUND(rsi,0) AS rsi, ROUND(macd_hist,3) AS macd_hist, ROUND(zscore,2) AS zscore, ROUND(rvol,2) AS rvol, ROUND(rv_ann*100,1) AS rv_pct, ROUND(garch_ann*100,1) AS garch_pct, ROUND(rmse_vs_naive,3) AS rmse_vs_naive, ROUND(hit_rate*100,1) AS hit_pct, ROUND(ic,3) AS ic, ROUND(auc,3) AS auc, ROUND(log_loss,3) AS log_loss, ROUND(sharpe,2) AS sharpe, ROUND(sortino,2) AS sortino, ROUND(max_dd*100,1) AS maxdd_pct, ROUND(profit_factor,2) AS pf, compute FROM quant ORDER BY mode, score DESC",
          "rawQueryText": "SELECT mode, symbol, ROUND(score,2) AS score, CASE edge WHEN 1 THEN 'yes' ELSE 'no' END AS oos_edge, CASE veto WHEN 1 THEN 'VETO' ELSE '' END AS gate, ROUND(size_mult,2) AS size_x, ROUND(rsi,0) AS rsi, ROUND(macd_hist,3) AS macd_hist, ROUND(zscore,2) AS zscore, ROUND(rvol,2) AS rvol, ROUND(rv_ann*100,1) AS rv_pct, ROUND(garch_ann*100,1) AS garch_pct, ROUND(rmse_vs_naive,3) AS rmse_vs_naive, ROUND(hit_rate*100,1) AS hit_pct, ROUND(ic,3) AS ic, ROUND(auc,3) AS auc, ROUND(log_loss,3) AS log_loss, ROUND(sharpe,2) AS sharpe, ROUND(sortino,2) AS sortino, ROUND(max_dd*100,1) AS maxdd_pct, ROUND(profit_factor,2) AS pf, compute FROM quant ORDER BY mode, score DESC",
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "transparent",
                      "value": -0.2
                    },
                    {
                      "color": "green",
                      "value": 0.2
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gate"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "score",
            "desc": true
          }
        ]
      }
