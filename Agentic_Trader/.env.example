# Safety: only "paper" is accepted.
TRADING_MODE=paper
TRADER_DATA_PROVIDER=mock        # mock | yfinance | alpaca | robinhood
TRADER_BROKER=paper              # paper | alpaca_paper
TRADER_STARTING_CASH=100000
TRADER_DAY_SYMBOLS=SPY,QQQ,AAPL,NVDA
TRADER_USE_GPU=1                 # 0 forces CPU even if CuPy is installed

# Discord (reuses the repo-root .env values if not set here)
DISCORD_BOT_TOKEN=
DISCORD_REALTIMETRADER_CHANNEL_ID=
DISCORD_UPDATES_CHANNEL_ID=

# Alpaca (free paper account + IEX data): https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Robinhood MCP (disabled until paper results are proven)
ROBINHOOD_MCP_COMMAND=
# Filled in automatically by `python -m agentic_trader rh-login`:
ROBINHOOD_CLIENT_ID=
ROBINHOOD_ACCESS_TOKEN=
ROBINHOOD_REFRESH_TOKEN=
ROBINHOOD_TOKEN_EXPIRES_AT=

# Telegram-only Robinhood account access (set in the ROOT .env, not here)
# TELEGRAM_ROBINHOOD_USER_IDS=123456789
# TELEGRAM_ROBINHOOD_CHAT_IDS=
# ROBINHOOD_LIVE_ORDERS=false
# ROBINHOOD_MAX_ORDER_USD=25
# ROBINHOOD_MAX_DAILY_USD=50
# ROBINHOOD_ANALYSIS_ACCOUNTS=all   # all = every account read-only (default agentic = MCP only); orders stay MCP-only

# Internal live paper trading (python -m agentic_trader paper-live). Robinhood = data only, never orders.
# PAPER_START_CASH=5000
# PAPER_ACCOUNT_TYPE=margin       # margin + equity >= PAPER_PDT_FREE_MIN_EQUITY (2000) = no day-trade limit
# PAPER_PDT_MAX_DAY_TRADES=3      # legacy limit if cash account or under the minimum
# PAPER_CORE_PCT=0.60             # ETF core sleeve
# PAPER_DAY_PCT=0.25              # day-trader sleeve (rest = reserve + hedge)
# PAPER_ETFS=VOO,QQQ,SCHD,VXUS
# PAPER_DAY_SYMBOLS=NVDA,AAPL,AMD,TSLA,MSFT,META
# PAPER_HEDGE_SYMBOL=SH           # 1x inverse S&P ETF (no options/margin/shorting)
# PAPER_CYCLE_SECONDS=300
# PAPER_DAILY_TARGET_MIN=0.02  PAPER_DAILY_TARGET_MAX=0.05  PAPER_WEEKLY_TARGET_MIN=0.08  PAPER_WEEKLY_TARGET_MAX=0.12
# PAPER_OPTIONS=1  PAPER_OPTION_SYMBOLS=F,SOFI,RIVN,SNAP,NIO,T,KVUE,CMCSA,PFE,SCHD  PAPER_OPTION_PCT=0.35  # covered/cash-secured only
# Day trader (intraday)
PAPER_DAY_MAX_TRADES=8
PAPER_DAY_MAX_OPEN=2
PAPER_DAY_RISK_PCT=0.005
PAPER_DAY_LOSS_LIMIT=0.015
PAPER_DAY_ATR_STOP_MULT=2.5
PAPER_DAY_TARGET_R=2.0
PAPER_DAY_REENTRY_MIN=30
PAPER_DAY_STRATEGIES=ORB,PULLBACK,MOMENTUM,REVERSION
PAPER_DAY_AGENT_MAX_OPEN=1
PAPER_DAY_AGENT_LOSS_LIMIT=0.007

# Alpha Vantage (free tier: 25 requests/day; OVERVIEW and NEWS_SENTIMENT are premium and skipped)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_PER_MINUTE=5

# Kaggle public datasets work without credentials; optional auth raises limits
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_MAX_DOWNLOAD_MB=50

# Pre-trade quant suite (RSI/MACD, Z-score, RVOL, GARCH, purged walk-forward, ...)
PAPER_QUANT_GATE=true
# Optional Gaming PC worker: run `python -m agentic_trader.quant_worker` there (port 8011)
# TRADER_QUANT_URL=http://192.168.50.1:8011
# TRADER_QUANT_TOKEN=
# TRADER_QUANT_PORT=8011
